[user]
    name = Marshall Ward
    email = marshall.ward@gmail.com
    #signingkey = XXXXXX
[color]
    branch = auto
    diff = auto
    interactive = auto
    status = auto
[core]
    editor = vim
[merge]
    tool = vimdiff
[pull]
    rebase = false
[sendemail]
    smtpserver = "/usr/bin/msmtp"
    smtpuser = marshall.ward
    smtpencryption = tls
    smtpserverport = 587
[init]
    defaultBranch = main
[commit]
    gpgSign = true
[gpg]
    program = /usr/bin/gpg
[pager]
    branch = false
